# Copy this file to .env and fill in real values. .env is gitignored, never commit it.

USE_MOCK_DATA=true

LIGHT_API_KEY=
LIGHT_API_BASE_URL=https://api.light.inc/v1
LIGHT_COMPANY_ENTITY_ID=

SLACK_WEBHOOK_URL=
SLACK_CHANNEL_ID=

# console | file | slack
OUTPUT_MODE=console
OUTPUT_FILE_PATH=output/alert.txt

# Comma-separated day boundaries: watch, attention, overdue
AGING_THRESHOLDS=7,14,30
TIMEZONE=UTC

# Daily digest time, 24h UTC clock -- stretch goal only
SCHEDULE_TIME=09:00
